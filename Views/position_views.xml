<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<!-- Tree View -->
	<record id="view_talent_position_tree" model="ir.ui.view">
		<field name="name">talent.position.tree</field>
		<field name="model">talent.position</field>
		<field name="arch" type="xml">
			<tree>
				<field name="name"/>
				<field name="company"/>
				<field name="total_applications"/>
			</tree>
		</field>
	</record>

	<!-- Form View -->
	<record id="view_talent_position_form" model="ir.ui.view">
		<field name="name">talent.position.form</field>
		<field name="model">talent.position</field>
		<field name="arch" type="xml">
			<form string="TalentHub Position">
				<header>
					<button name="action_export_to_talenthub"
                            string="Export to TalentHub"
                            type="object"
                            class="btn-primary"
                            confirm="Are you sure you want to export this position to TalentHub?"/>
				</header>
				<sheet>
					<group>
						<group>
							<field name="name"/>
							<field name="company"/>
							<field name="total_applications"/>
						</group>
						<group>
							<field name="project_tags"/>
							<field name="api_token_used"/>
						</group>
					</group>
					<group>
						<field name="description"/>
					</group>
					<notebook>
						<page string="Attributes">
							<field name="attribute_ids">
								<tree editable="bottom">
									<field name="name"/>
									<field name="attribute_type"/>
									<field name="aggregated_value"/>
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<!-- Action -->
	<record id="action_talent_position" model="ir.actions.act_window">
		<field name="name">Positions</field>
		<field name="res_model">talent.position</field>
		<field name="view_mode">tree,form</field>
	</record>

	<!-- Menu -->
	<menuitem id="menu_talenthub_root" name="TalentHub" sequence="10"/>
	<menuitem id="menu_talent_positions"
              name="Positions"
              parent="menu_talenthub_root"
              action="action_talent_position"
              sequence="10"/>

</odoo>